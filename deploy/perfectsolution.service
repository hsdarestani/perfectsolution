[Unit]
Description=Perfect Solution Django
After=network.target
[Service]
User=root
Group=www-data
WorkingDirectory=/opt/perfectsolution/current
EnvironmentFile=/opt/perfectsolution/shared/.env
ExecStart=/opt/perfectsolution/shared/venv/bin/gunicorn perfectsolution.wsgi:application --bind 127.0.0.1:8091 --workers 3 --timeout 60
Restart=always
[Install]
WantedBy=multi-user.target
